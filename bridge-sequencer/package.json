{
    "name": "cross-chain-bridge-monitor",
    "version": "1.0.0",
    "type": "module",
    "description": "Monitor for cross-chain TokenBridge events with viem and SQLite",
    "main": "dist/bridge-monitor.js",
    "scripts": {
      "build": "tsc",
      "start": "bun run dist/bridge-monitor.js",
      "dev": "bun --watch src/bridge-monitor.ts",
      "dev:debug": "bun --watch --inspect src/bridge-monitor.ts",
      "typecheck": "tsc --noEmit",
      "typecheck:watch": "tsc --noEmit --watch"
    },
    "dependencies": {
      "dotenv": "^16.3.1",
      "sqlite": "^5.1.1",
      "sqlite3": "^5.1.6",
      "viem": "^2.0.0"
    },
    "devDependencies": {
      "@types/node": "^20.10.0",
      "typescript": "^5.3.2"
    }
  }